        "retry": "மீண்டும் முயற்சி செய்யவும்"
      },
      "steps": [
        {
          "type": "teach",
          "text": "க் உடன் அ உயிர் சேர்ந்தால் க எழுத்து உருவாகும். கல் என்ற சொல்லைக் கேளுங்கள்.",
          "speech": "க் உடன் அ உயிர் சேர்ந்தால் க எழுத்து உருவாகும். கல் என்ற சொல்லைக் கேளுங்கள்."
        },
        {
          "type": "practice",
          "prompt": "க் + அ = ?",
          "options": [
            "க",
            "க்",
            "கூ"
          ],
          "answer": "க",
          "shuffle_options": true,
          "feedback_correct": "மிக நன்று!"
