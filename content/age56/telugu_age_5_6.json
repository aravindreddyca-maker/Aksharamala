    {
      "id": "telugu-56-001",
      "module": "telugu",
      "age_band": "5-6",
      "level": 1,
      "skill": "combine_vowel_sign",
      "topic": "gunintalu",
      "title": "క + ా = కా",
      "objective": "Learner can combine vowel sign in gunintalu.",
      "prerequisites": [],
      "instructions": {
        "listen": "విని నేర్చుకోండి",
        "choose": "సరైన సమాధానాన్ని ఎంచుకోండి",
        "retry": "మళ్లీ ప్రయత్నించండి"
      },
      "steps": [
        {
          "type": "teach",
          "text": "క కు ా గుర్తు కలిపితే కా అవుతుంది. కాకి అనే పదాన్ని వినండి.",
          "speech": "క కు ా గుర్తు కలిపితే కా అవుతుంది. కాకి అనే పదాన్ని వినండి."
        },
        {
          "type": "practice",
          "prompt": "క + ా = ?",
          "options": [
            "కా",
            "క",
            "కూ"
          ],
          "answer": "కా",
          "shuffle_options": true,
          "feedback_correct": "బాగా చేశారు!"
        }
      ],
      "examples": [
        {
          "word": "కాకి",
          "meaning": "crow"
        }
      ],
      "requires": [
        "native_educator_review"
      ],
      "status": "draft_ready_for_technical_integration"
    },
